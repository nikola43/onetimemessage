# ===========================================
# OneTimeMessage Configuration
# ===========================================

# MySQL Configuration
# -------------------------------------------
MYSQL_ROOT_PASSWORD=your-secure-root-password
MYSQL_PASSWORD=your-secure-db-password

# Encryption Key (64 hex characters = 256 bits)
# -------------------------------------------
# Generate a new key with: openssl rand -hex 32
# IMPORTANT: Keep this key secure and never share it!
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# URLs
# -------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# CORS Configuration
# -------------------------------------------
# For production, set to your domain(s)
# Multiple origins: https://example.com,https://www.example.com
ALLOWED_ORIGINS=*

# Logging
# -------------------------------------------
# Options: trace, debug, info, warn, error
RUST_LOG=info
